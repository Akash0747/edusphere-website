# Copy to .env and fill in. Never commit the filled file.
# (The repository currently has no .gitignore — add one with .env, .venv/,
#  __pycache__/, *.pyc.)

# --- Required: PostgreSQL / Supabase Postgres ---
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# --- Initial admin (used only when the admins table is empty) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password

# --- Supabase Storage (required for PDF uploads) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SECRET_KEY=            # alternative name accepted by app.py
SUPABASE_BUCKET=edusphere-papers  # must be a PUBLIC bucket

# --- Cookies / CORS ---
# Set false for local development over http://localhost, otherwise the
# Secure cookie is not stored by the browser.
COOKIE_SECURE=true
CORS_ORIGINS=https://your-frontend.example.com,http://localhost:3000

# --- Proposed patch only ---
# Enables the https://*.netlify.app wildcard. Leave false in production:
# any Netlify-hosted page could otherwise make credentialed admin requests.
CORS_ALLOW_NETLIFY_PREVIEWS=false
