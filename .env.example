# ─────────────────────────────────────────────────────────────────────────────
# EduSphere — backend environment variables
# Copy to `.env` and fill in real values. NEVER commit the filled file.
# The FRONTEND needs none of these; its catalogue is already bundled in HTML.
# Names below are read directly by backend/app.py (commit 9607a80).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED — the app raises at import time if this is empty) ─────
# With the bundled docker-compose.yml:
DATABASE_URL=postgresql://edusphere:edusphere@localhost:5432/edusphere

# ── Supabase Storage (needed for PDF uploads) ───────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Alternative name also accepted by the code:
# SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_BUCKET=edusphere-papers

# ── Initial administrator ───────────────────────────────────────────────────
# ADMIN_EMAIL defaults to admin@edusphere.com.
# ADMIN_PASSWORD is used ONLY when the admins table is empty — it cannot rotate
# an existing password. Remove it from the environment after the first run.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-long-random-password

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of exact origins. Defaults (in code) to
# https://souray.netlify.app,http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ── Cookie security ─────────────────────────────────────────────────────────
# Defaults to true (Secure; SameSite=None). MUST be false for local HTTP,
# otherwise the browser will not store the session cookie.
COOKIE_SECURE=false

# ── Fixed in code (not configurable) ────────────────────────────────────────
# SESSION_COOKIE = "archive_session"  (HttpOnly, 7-day TTL)
# MAX_PDF_BYTES  = 50 * 1024 * 1024  (50 MB upload limit)
