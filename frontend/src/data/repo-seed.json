    {
      "id": 1,
      "exam": "jee-main",
      "subject": "Physics",
      "question": "Two point charges +8q and -2q are located at x = 0 and x = L respectively. The point on the x-axis at which the net electric field is zero is:",
      "option_a": "8L",
      "option_b": "4L",
      "option_c": "2L",
      "option_d": "L/4",
      "correct_option": "C",
      "explanation": "By Coulomb Law, k(8q)/x^2 = k(2q)/(x-L)^2 => 2/x = 1/(x-L) => x = 2L.",
      "official_source": "NTA JEE Main Official"
    },
    {
      "id": 2,
      "exam": "cbse-12",
      "subject": "Mathematics",
      "question": "If A is a square matrix of order 3 such that |adj A| = 64, then the value of |A| is:",
      "option_a": "8 only",
      "option_b": "-8 only",
      "option_c": "64",
      "option_d": "8 or -8",
      "correct_option": "D",
      "explanation": "|adj A| = |A|^(n-1). For n=3, |A|^2 = 64 => |A| = +8 or -8.",
      "official_source": "CBSE Class 12 SQP"
    }
  ]
